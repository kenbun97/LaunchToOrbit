GLOBAL CONTROL_STATE IS LEXICON(
    "LAUNCH_REQUESTED", FALSE,
    "ABORT_REQUESTED", FALSE,
    "MANUAL_OVERRIDE", FALSE
).

FUNCTION CheckLaunchInput {
    IF SHIP:CONTROL:PILOTMAINTHROTTLE > 0.5 {
        SET CONTROL_STATE["LAUNCH_REQUESTED"] TO TRUE.
        RETURN TRUE.
    }
    RETURN FALSE.
}

FUNCTION CheckAbortInput {
    IF SHIP:CONTROL:PILOTPITCH < -0.8 {
        SET CONTROL_STATE["ABORT_REQUESTED"] TO TRUE.
        RETURN TRUE.
    }
    RETURN FALSE.
}

FUNCTION BindAbortAction {
    ON AG10 {
        SET CONTROL_STATE["ABORT_REQUESTED"] TO TRUE.
    }
}

FUNCTION ClearControlRequests {
    SET CONTROL_STATE["LAUNCH_REQUESTED"] TO FALSE.
    SET CONTROL_STATE["ABORT_REQUESTED"] TO FALSE.
}
