GLOBAL CURRENT_WAYPOINT_INDEX IS 0.
GLOBAL TARGET_HEADING IS 0.
GLOBAL TARGET_PITCH IS 90.
GLOBAL TARGET_ROLL IS 0.
GLOBAL CORRECTION_BURN_COUNT IS 0.

FUNCTION ExecuteVerticalAscent {
    SET TARGET_PITCH TO 90 - DEFAULTS["VERTICAL_ASCENT_PITCH"].
    SET TARGET_HEADING TO 90.
    SET TARGET_ROLL TO 0.
    
    SET SHIP:CONTROL:MAINTHROTTLE TO 1.0.
    LOCK STEERING TO HEADING(TARGET_HEADING, TARGET_PITCH, TARGET_ROLL).
}

FUNCTION ExecuteGravityTurn {
    IF CURRENT_WAYPOINT_INDEX = 0 {
        SET CURRENT_WAYPOINT_INDEX TO 1.
    }
    
    LOCAL alt_range IS MISSION_CONFIG["TARGET_APOAPSIS"] - MISSION_CONFIG["GRAVITY_TURN_START_ALTITUDE"].
    LOCAL current_alt IS SHIP:ALTITUDE - MISSION_CONFIG["GRAVITY_TURN_START_ALTITUDE"].
    LOCAL s IS CURRENT(current_alt / alt_range, 0, 1).
    
    LOCAL pitch_at_start IS 90 - DEFAULTS["VERTICAL_ASCENT_PITCH"].
    LOCAL pitch_at_apoapsis IS 0.
    LOCAL smoothstep IS 10 * (s ^ 3) - 15 * (s ^ 4) + 6 * (s ^ 5).
    
    SET TARGET_PITCH TO pitch_at_start + (pitch_at_apoapsis - pitch_at_start) * smoothstep.
    SET TARGET_HEADING TO 90.
    SET TARGET_ROLL TO 0.
    
    SET SHIP:CONTROL:MAINTHROTTLE TO 1.0.
    LOCK STEERING TO HEADING(TARGET_HEADING, TARGET_PITCH, TARGET_ROLL).
}

FUNCTION ExecuteApoapsisTargeting {
    LOCAL target_apo IS MISSION_CONFIG["TARGET_APOAPSIS"].
    LOCAL current_apo IS SHIP:APOAPSIS.
    LOCAL apo_error IS target_apo - current_apo.
    
    IF apo_error <= 100 {
        LOCAL remaining_alt IS target_apo - SHIP:ALTITUDE.
        LOCAL _throttle IS MAX(0, MIN(1, remaining_alt / 10000)).
        SET SHIP:CONTROL:MAINTHROTTLE TO _throttle.
    } ELSE {
        SET SHIP:CONTROL:MAINTHROTTLE TO 1.0.
    }
    
    SET TARGET_PITCH TO 0.
    SET TARGET_HEADING TO 90.
    SET TARGET_ROLL TO 0.
    LOCK STEERING TO HEADING(TARGET_HEADING, TARGET_PITCH, TARGET_ROLL).
}

FUNCTION ExecuteCoastToApoapsis {
    SET SHIP:CONTROL:MAINTHROTTLE TO 0.
    
    SET TARGET_PITCH TO 0.
    SET TARGET_HEADING TO 90.
    SET TARGET_ROLL TO 0.
    LOCK STEERING TO HEADING(TARGET_HEADING, TARGET_PITCH, TARGET_ROLL).
    
    IF SHIP:ALTITUDE > SHIP:BODY:ATM:HEIGHT {
        KUNIVERSE:TIMEWARP:CANCELWARP().
    }
}

FUNCTION ExecuteOrbitalInsertion {
    LOCAL peri_error IS MISSION_CONFIG["TARGET_PERIAPSIS"] - SHIP:PERIAPSIS.
    
    IF peri_error > DEFAULTS["PERIAPSIS_TOLERANCE"] {
        SET SHIP:CONTROL:MAINTHROTTLE TO 0.3.
        SET TARGET_PITCH TO 0.
        SET TARGET_HEADING TO 90.
        LOCK STEERING TO HEADING(TARGET_HEADING, TARGET_PITCH, TARGET_ROLL).
    } ELSE {
        SET SHIP:CONTROL:MAINTHROTTLE TO 0.
    }
}

FUNCTION ExecuteOrbitCorrection {
    LOCAL apo_error IS ABS(SHIP:APOAPSIS - MISSION_CONFIG["TARGET_APOAPSIS"]).
    LOCAL peri_error IS ABS(SHIP:PERIAPSIS - MISSION_CONFIG["TARGET_PERIAPSIS"]).
    
    IF peri_error > DEFAULTS["PERIAPSIS_TOLERANCE"] AND CORRECTION_BURN_COUNT < DEFAULTS["MAX_CORRECTION_BURNS"] {
        SET CORRECTION_BURN_COUNT TO CORRECTION_BURN_COUNT + 1.
        SET SHIP:CONTROL:MAINTHROTTLE TO 0.1.
        SET TARGET_PITCH TO 0.
        LOCK STEERING TO HEADING(TARGET_HEADING, TARGET_PITCH, TARGET_ROLL).
    } ELSE {
        SET SHIP:CONTROL:MAINTHROTTLE TO 0.
    }
}

FUNCTION ExecuteMissionComplete {
    SET SHIP:CONTROL:MAINTHROTTLE TO 0.
    UNLOCK STEERING.
    UNLOCK THROTTLE.
    PRINT "Mission complete! Final orbit:".
    PRINT "  Apoapsis: " + ROUND(SHIP:APOAPSIS, 1) + " m".
    PRINT "  Periapsis: " + ROUND(SHIP:PERIAPSIS, 1) + " m".
    PRINT "  Inclination: " + ROUND(SHIP:ORBIT:INCLINATION, 2) + "°".
}

FUNCTION CURRENT {
    PARAMETER value, min_val, max_val.
    IF value < min_val {
        RETURN 0.
    }
    IF value > max_val {
        RETURN 1.
    }
    RETURN (value - min_val) / (max_val - min_val).
}
