GLOBAL MISSION_CONFIG IS LEXICON().

FUNCTION InitializeMissionConfig {
    GLOBAL MISSION_CONFIG IS LEXICON(
        "BODY", BODY,
        "TARGET_APOAPSIS", DEFAULTS["TARGET_APOAPSIS"],
        "TARGET_PERIAPSIS", DEFAULTS["TARGET_PERIAPSIS"],
        "TARGET_INCLINATION", DEFAULTS["TARGET_INCLINATION"],
        "TARGET_RAAN", DEFAULTS["TARGET_RAAN"],
        "TARGET_ARG_OF_PERIAPSIS", DEFAULTS["TARGET_ARG_OF_PERIAPSIS"],
        "GRAVITY_TURN_AGGRESSIVENESS", DEFAULTS["GRAVITY_TURN_AGGRESSIVENESS"],
        "GRAVITY_TURN_WAYPOINTS", DEFAULTS["GRAVITY_TURN_WAYPOINTS"],
        "GRAVITY_TURN_START_ALTITUDE", DEFAULTS["GRAVITY_TURN_START_ALTITUDE"],
        "STAGING_MANIFEST", LIST(),
        "LAUNCH_SITE_LATITUDE", SHIP:GEOPOSITION:LAT,
        "LAUNCH_SITE_LONGITUDE", SHIP:GEOPOSITION:LNG,
        "VESSEL_NAME", SHIP:NAME
    ).
}

FUNCTION SetMissionParameter {
    PARAMETER key, value.

    IF MISSION_CONFIG:HASKEY(key) {
        SET MISSION_CONFIG[key] TO value.
        RETURN TRUE.
    }

    RETURN FALSE.
}

FUNCTION GetMissionParameter {
    PARAMETER key.
    
    IF MISSION_CONFIG:HASKEY(key) {
        RETURN MISSION_CONFIG[key].
    }
    RETURN DEFAULTS[key].
}

FUNCTION ValidateMissionConfig {
    LOCAL errors IS LIST().
    
    IF MISSION_CONFIG["TARGET_APOAPSIS"] < 0 {
        errors:ADD("Target apoapsis must be positive").
    }
    IF MISSION_CONFIG["TARGET_PERIAPSIS"] < 0 {
        errors:ADD("Target periapsis must be positive").
    }
    IF MISSION_CONFIG["GRAVITY_TURN_WAYPOINTS"] < DEFAULTS["MIN_WAYPOINTS"] OR MISSION_CONFIG["GRAVITY_TURN_WAYPOINTS"] > DEFAULTS["MAX_WAYPOINTS"] {
        errors:ADD("Waypoint count must be between " + DEFAULTS["MIN_WAYPOINTS"] + " and " + DEFAULTS["MAX_WAYPOINTS"]).
    }
    IF MISSION_CONFIG["GRAVITY_TURN_AGGRESSIVENESS"] < 0 OR MISSION_CONFIG["GRAVITY_TURN_AGGRESSIVENESS"] > 1 {
        errors:ADD("Gravity turn aggressiveness must be between 0 and 1").
    }
    
    RETURN errors.
}
